# Copy to .env. Never commit .env.

# Optional. Without it the assistant falls back to templates and the
# CV pipeline is unaffected — the demo must work with no network.
ANTHROPIC_API_KEY=

DATABASE_URL=sqlite:///./handleguard.db
DATA_DIR=./data
MODELS_DIR=./models

# Comma-separated origins for the dashboard
CORS_ORIGINS=http://localhost:5173

MAX_UPLOAD_MB=500
